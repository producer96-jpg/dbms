Step 1:- Create Library Table

CREATE TABLE Library (
    book_id INT PRIMARY KEY,
    book_name VARCHAR(100),
    author VARCHAR(100),
    category VARCHAR(50),
    date DATE,
    operation VARCHAR(20)
);

Step 2:-Create Library_Audit Table

CREATE TABLE Library_Audit (
    book_id INT,
    book_name VARCHAR(100),
    author VARCHAR(100),
    category VARCHAR(50),
    date DATE,
    operation VARCHAR(20)
);

