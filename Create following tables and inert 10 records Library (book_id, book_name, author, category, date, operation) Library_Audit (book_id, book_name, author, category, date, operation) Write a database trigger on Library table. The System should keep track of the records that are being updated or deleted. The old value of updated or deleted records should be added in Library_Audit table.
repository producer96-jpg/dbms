Step 4:-Create UPDATE Trigger

DELIMITER //

CREATE TRIGGER Library_Update_Trigger
BEFORE UPDATE ON Library
FOR EACH ROW
BEGIN
    INSERT INTO Library_Audit
    VALUES (
        OLD.book_id,
        OLD.book_name,
        OLD.author,
        OLD.category,
        OLD.date,
        'UPDATE'
    );
END //

DELIMITER ;

Step 5:-Create DELETE Trigger

DELIMITER //

CREATE TRIGGER Library_Delete_Trigger
BEFORE DELETE ON Library
FOR EACH ROW
BEGIN
    INSERT INTO Library_Audit
    VALUES (
        OLD.book_id,
        OLD.book_name,
        OLD.author,
        OLD.category,
        OLD.date,
        'DELETE'
    );
END //

DELIMITER ;

