Step4:-Create Stored Procedure proc_Grade

DELIMITER //

CREATE PROCEDURE proc_Grade()
BEGIN
    DECLARE done INT DEFAULT 0;
    DECLARE s_name VARCHAR(50);
    DECLARE marks INT;
    DECLARE roll_no INT DEFAULT 1;
    DECLARE grade VARCHAR(30);

    DECLARE cur CURSOR FOR
        SELECT name, total_marks FROM Stud_Marks;

    DECLARE CONTINUE HANDLER FOR NOT FOUND
        SET done = 1;

    OPEN cur;

    read_loop: LOOP
        FETCH cur INTO s_name, marks;

        IF done = 1 THEN
            LEAVE read_loop;
        END IF;

        IF marks >= 990 AND marks <= 1500 THEN
            SET grade = 'Distinction';

        ELSEIF marks >= 900 AND marks <= 989 THEN
            SET grade = 'First Class';

        ELSEIF marks >= 825 AND marks <= 899 THEN
            SET grade = 'Higher Second Class';

        ELSE
            SET grade = 'Pass Class';
        END IF;

        INSERT INTO Result (Roll, Name, Class)
        VALUES (roll_no, s_name, grade);

        SET roll_no = roll_no + 1;

    END LOOP;

    CLOSE cur;
END //

DELIMITER ;

Step5:-Execute Stored Procedure
CALL proc_Grade();

Step6:-Display Result Table
SELECT * FROM Result;
