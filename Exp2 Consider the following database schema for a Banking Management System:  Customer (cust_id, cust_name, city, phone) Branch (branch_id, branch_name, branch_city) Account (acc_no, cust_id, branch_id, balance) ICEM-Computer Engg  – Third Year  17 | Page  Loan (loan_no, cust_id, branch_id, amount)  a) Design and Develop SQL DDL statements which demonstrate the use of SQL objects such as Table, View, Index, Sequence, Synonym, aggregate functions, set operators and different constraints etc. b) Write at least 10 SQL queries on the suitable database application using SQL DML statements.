Step3:- VIEW

CREATE OR REPLACE VIEW account_details_v AS
SELECT a.acc_no, c.cust_name, c.city, b.branch_name, a.balance
FROM Account a
JOIN Customer c ON a.cust_id = c.cust_id
JOIN Branch b ON a.branch_id = b.branch_id;

-- Display view
SELECT * FROM account_details_v;

