
Step1:- TABLES AND CONSTRAINTS
 
CREATE TABLE Customer (
    cust_id   NUMBER(5),
    cust_name VARCHAR2(50) NOT NULL,
    city      VARCHAR2(40) NOT NULL,
    phone     VARCHAR2(15) UNIQUE,
    CONSTRAINT pk_customer PRIMARY KEY (cust_id)
);

CREATE TABLE Branch (
    branch_id   NUMBER(5),
    branch_name VARCHAR2(50) NOT NULL,
    branch_city VARCHAR2(40) NOT NULL,
    CONSTRAINT pk_branch PRIMARY KEY (branch_id)
);

CREATE TABLE Account (
    acc_no    NUMBER(10),
    cust_id   NUMBER(5) NOT NULL,
    branch_id NUMBER(5) NOT NULL,
    balance   NUMBER(12,2) DEFAULT 0 NOT NULL,
    CONSTRAINT pk_account PRIMARY KEY (acc_no),
    CONSTRAINT fk_account_customer FOREIGN KEY (cust_id)
        REFERENCES Customer(cust_id),
    CONSTRAINT fk_account_branch FOREIGN KEY (branch_id)
        REFERENCES Branch(branch_id),
    CONSTRAINT chk_account_balance CHECK (balance >= 0)
);

CREATE TABLE Loan (
    loan_no   NUMBER(10),
    cust_id   NUMBER(5) NOT NULL,
    branch_id NUMBER(5) NOT NULL,
    amount    NUMBER(12,2) NOT NULL,
    CONSTRAINT pk_loan PRIMARY KEY (loan_no),
    CONSTRAINT fk_loan_customer FOREIGN KEY (cust_id)
        REFERENCES Customer(cust_id),
    CONSTRAINT fk_loan_branch FOREIGN KEY (branch_id)
        REFERENCES Branch(branch_id),
    CONSTRAINT chk_loan_amount CHECK (amount > 0)
);

